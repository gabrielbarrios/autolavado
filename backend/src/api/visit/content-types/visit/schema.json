{
  "kind": "collectionType",
  "collectionName": "visits",
  "info": {
    "singularName": "visit",
    "pluralName": "visits",
    "displayName": "Visit",
    "description": "Visitas registradas para fidelidad"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "date": {
      "type": "datetime",
      "required": true
    },
    "notes": {
      "type": "text"
    },
    "user": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user"
    },
    "vehicle": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::vehicle.vehicle"
    },
    "package": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::package.package"
    },
    "extraServices": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::extra-service.extra-service"
    }
  }
}
