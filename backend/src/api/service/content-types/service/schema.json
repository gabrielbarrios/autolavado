{
  "kind": "collectionType",
  "collectionName": "services",
  "info": {
    "singularName": "service",
    "pluralName": "services",
    "displayName": "Servicio",
    "description": "Lavados realizados: del tablero hasta el cobro"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "date": {
      "type": "datetime",
      "required": true
    },
    "startedAt": {
      "type": "datetime"
    },
    "finishedAt": {
      "type": "datetime"
    },
    "notes": {
      "type": "text"
    },
    "totalAmount": {
      "type": "decimal",
      "required": true,
      "min": 0
    },
    "subtotalAmount": {
      "type": "decimal",
      "min": 0
    },
    "promotionDiscount": {
      "type": "decimal",
      "default": 0,
      "min": 0
    },
    "manualDiscount": {
      "type": "decimal",
      "default": 0,
      "min": 0
    },
    "discountNote": {
      "type": "string"
    },
    "promotion": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::promotion.promotion"
    },
    "user": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user"
    },
    "performedBy": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user"
    },
    "vehicle": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::vehicle.vehicle"
    },
    "package": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::package.package"
    },
    "extraServices": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::extra-service.extra-service"
    },
    "appointment": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::appointment.appointment"
    },
    "isWalkIn": {
      "type": "boolean",
      "default": false
    },
    "customerName": {
      "type": "string"
    },
    "vehicleType": {
      "type": "string",
      "description": "Slug de un Tipo de auto (api::vehicle-type). Antes era un enum fijo."
    },
    "isUberTaxi": {
      "type": "boolean",
      "default": false
    },
    "status": {
      "type": "enumeration",
      "enum": [
        "waiting",
        "in_progress",
        "to_pay",
        "completed",
        "cancelled"
      ],
      "default": "waiting",
      "required": true
    }
  }
}
