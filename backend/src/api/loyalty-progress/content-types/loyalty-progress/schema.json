{
  "kind": "collectionType",
  "collectionName": "loyalty_progresses",
  "info": {
    "singularName": "loyalty-progress",
    "pluralName": "loyalty-progresses",
    "displayName": "Progreso de fidelidad",
    "description": "Visitas acumuladas del ciclo actual de cada auto de cada cliente"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "currentCount": {
      "type": "integer",
      "default": 0,
      "min": 0
    },
    "visitsRequired": {
      "type": "integer",
      "min": 1
    },
    "cycleStartedAt": {
      "type": "datetime"
    },
    "user": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user"
    },
    "vehicle": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::vehicle.vehicle",
      "description": "Auto al que pertenece este contador. Cada auto acumula sus propias visitas."
    }
  }
}
