{
  "kind": "collectionType",
  "collectionName": "vehicles",
  "info": {
    "singularName": "vehicle",
    "pluralName": "vehicles",
    "displayName": "Auto",
    "description": "Autos registrados por los clientes"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "brand": {
      "type": "string",
      "required": true
    },
    "model": {
      "type": "string",
      "required": true
    },
    "year": {
      "type": "integer",
      "required": true,
      "min": 1950
    },
    "color": {
      "type": "string",
      "required": true
    },
    "plate": {
      "type": "string",
      "unique": true
    },
    "notes": {
      "type": "text"
    },
    "vehicleType": {
      "type": "string",
      "default": "sedan",
      "required": true,
      "description": "Slug de un Tipo de auto (api::vehicle-type). Antes era un enum fijo."
    },
    "isUberTaxi": {
      "type": "boolean",
      "default": false
    },
    "photo": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images"
      ]
    },
    "user": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user"
    }
  }
}
