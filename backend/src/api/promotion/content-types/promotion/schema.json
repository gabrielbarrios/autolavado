{
  "kind": "collectionType",
  "collectionName": "promotions",
  "info": {
    "singularName": "promotion",
    "pluralName": "promotions",
    "displayName": "Promoción",
    "description": "Campañas del negocio y recompensas de fidelidad"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "code": {
      "type": "string",
      "unique": true
    },
    "title": {
      "type": "string",
      "required": true
    },
    "description": {
      "type": "text"
    },
    "kind": {
      "type": "enumeration",
      "enum": [
        "personal",
        "campaign"
      ],
      "default": "campaign",
      "required": true
    },
    "availability": {
      "type": "enumeration",
      "enum": [
        "always",
        "weekdays",
        "dateRange"
      ],
      "default": "dateRange",
      "required": true
    },
    "weekdays": {
      "type": "json"
    },
    "appliesTo": {
      "type": "enumeration",
      "enum": [
        "all",
        "package",
        "extras"
      ],
      "default": "all",
      "required": true
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "discountType": {
      "type": "enumeration",
      "enum": [
        "percent",
        "fixed",
        "free"
      ],
      "default": "percent",
      "required": true
    },
    "discountValue": {
      "type": "decimal",
      "default": 0
    },
    "validFrom": {
      "type": "datetime"
    },
    "validUntil": {
      "type": "datetime"
    },
    "used": {
      "type": "boolean",
      "default": false
    },
    "usedAt": {
      "type": "datetime"
    },
    "user": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user"
    },
    "packages": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::package.package",
      "description": "Paquetes en los que se puede usar. Vacío = cualquiera."
    }
  }
}
