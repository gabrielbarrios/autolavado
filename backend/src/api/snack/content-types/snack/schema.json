{
  "kind": "collectionType",
  "collectionName": "snacks",
  "info": {
    "singularName": "snack",
    "pluralName": "snacks",
    "displayName": "Snack",
    "description": "Snacks y bebidas a la venta en el mostrador: nombre y, si se quiere, precio"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "price": {
      "type": "decimal",
      "min": 0,
      "description": "Opcional: un snack sin precio se muestra como 'Consultar' y se cobra en caja"
    },
    "order": {
      "type": "integer",
      "default": 0
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "category": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::snack-category.snack-category",
      "inversedBy": "snacks"
    }
  }
}
