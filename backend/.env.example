# Server
HOST=0.0.0.0
PORT=1337

# Secrets (generar valores únicos en producción)
APP_KEYS=key1,key2,key3,key4
API_TOKEN_SALT=changeme
ADMIN_JWT_SECRET=changeme
TRANSFER_TOKEN_SALT=changeme
JWT_SECRET=changeme
ENCRYPTION_KEY=changeme

# Database (PostgreSQL en docker-compose)
DATABASE_CLIENT=postgres
DATABASE_HOST=localhost
DATABASE_PORT=5433
DATABASE_NAME=autolavado
DATABASE_USERNAME=autolavado
DATABASE_PASSWORD=autolavado
DATABASE_SSL=false

# Cloudinary (upload provider) — credenciales en el dashboard de Cloudinary
CLOUDINARY_NAME=changeme
CLOUDINARY_KEY=changeme
CLOUDINARY_SECRET=changeme
